[node name="HBox" type="HBoxContainer" parent="BottomRightFooter"]
layout_mode = 2
theme_override_constants/separation = 14
alignment = 2

[node name="NewsBtn" type="Button" parent="BottomRightFooter/HBox"]
custom_minimum_size = Vector2(150, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "📰  NEWS"
script = ExtResource("2_racebutton")

[node name="CustomizeBtn" type="Button" parent="BottomRightFooter/HBox"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "🎨  CUSTOMIZE"
script = ExtResource("2_racebutton")

[node name="QuitBtn" type="Button" parent="BottomRightFooter/HBox"]
custom_minimum_size = Vector2(120, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "⏻  QUIT"
script = ExtResource("2_racebutton")
