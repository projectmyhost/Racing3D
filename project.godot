; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sunset Street Racing"
run/main_scene="res://scenes/main/home_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

PlayerProfile="*res://scripts/core/player_profile.gd"
QualitySettings="*res://scripts/core/quality_settings.gd"
GPUPerfOverlay="*res://scripts/debug/gpu_perf_overlay.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_jitter_fix=0.0
common/physics_interpolation=true

[rendering]

renderer/rendering_method.mobile="forward_plus"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.08, 0.08, 0.12, 1)
anti_aliasing/quality/use_taa=true
occlusion_culling/use_occlusion_culling=true
