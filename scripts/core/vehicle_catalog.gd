static func get_all_ids() -> Array[String]:
	return ORDER.duplicate()

static func get_car_data(car_id: String) -> Dictionary:
	if FLEET_DATA.has(car_id):
		return FLEET_DATA[car_id]
	return FLEET_DATA["sedan"]

static func get_index_of(car_id: String) -> int:
	var idx: int = ORDER.find(car_id)
	return idx if idx >= 0 else 0

static func format_number(val: int) -> String:
	var s: String = str(abs(val))
	var res: String = ""
	var count: int = 0
	for i in range(s.length() - 1, -1, -1):
		res = s[i] + res
		count += 1
		if count % 3 == 0 and i > 0:
			res = "," + res
	return ("-" if val < 0 else "") + res

static func format_price(car_data: Dictionary) -> String:
	var c: int = int(car_data.get("cost_coins", 0))
	var g: int = int(car_data.get("cost_gems", 0))
	if c <= 0 and g <= 0:
		return "STARTER"
	if c > 0:
		return "%s COINS" % format_number(c)
	return "%s GEMS" % format_number(g)
